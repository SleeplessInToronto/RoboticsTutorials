<?xml version="1.0"?>
<!--
  lidar_car/model.sdf — adapted from ekf_se3_localization/models/ekf_car/model.sdf.
  Beacon-specific comments removed. Model name changed to "lidar_car".
  All physics, geometry, LiDAR sensor, and diff-drive plugin are identical.
-->
<sdf version="1.9">
  <model name="lidar_car">

    <link name="base_link">
      <pose>0 0 0.7 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>5.0</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>20.0</iyy><iyz>0</iyz>
          <izz>22.5</izz>
        </inertia>
      </inertial>
      <visual name="chassis">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry><box><size>4.0 2.0 0.35</size></box></geometry>
        <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
      </visual>
      <visual name="cabin">
        <pose>-0.2 0 0.4 0 0 0</pose>
        <geometry><box><size>1.8 1.7 0.45</size></box></geometry>
        <material><ambient>0.15 0.3 0.65 1</ambient><diffuse>0.15 0.3 0.65 1</diffuse></material>
      </visual>
      <visual name="hood">
        <pose>1.1 0 0.2 0 0 0</pose>
        <geometry><box><size>1.2 1.8 0.08</size></box></geometry>
        <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
      </visual>
      <visual name="lidar_housing">
        <pose>-0.2 0 0.65 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>4.0 2.0 0.6</size></box></geometry>
      </collision>

      <!-- VLP-16 style LiDAR (16 channels, ±15° vertical, 360° horizontal) -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.8 0 0 0</pose>
        <topic>/lidar</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.26179939</min_angle>
              <max_angle>0.26179939</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>20.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
        <alwaysOn>1</alwaysOn>
        <visualize>true</visualize>
      </sensor>
    </link>

    <link name="front_left_wheel">
      <pose>1.3 1.1 0.35 1.5707963 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="front_right_wheel">
      <pose>1.3 -1.1 0.35 1.5707963 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="rear_left_wheel">
      <pose>-1.3 1.1 0.35 1.5707963 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="rear_right_wheel">
      <pose>-1.3 -1.1 0.35 1.5707963 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>0.05</iyy><iyz>0</iyz><izz>0.05</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
            <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
            <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
            <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz>
            <limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>2.2</wheel_separation>
      <wheel_radius>0.35</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>/gz/tf_unused</tf_topic>
    </plugin>

  </model>
</sdf>
